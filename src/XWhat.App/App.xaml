<Application x:Class="XWhat.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#141B26" />
    <SolidColorBrush x:Key="Accent" Color="#6FE7CF" />
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EFF5FC" /><Setter Property="Margin" Value="0,5" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Foreground" Value="#142034" /><Setter Property="Background" Value="#DAE4F0" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="5" /><Setter Property="MinHeight" Value="29" /><Setter Property="Foreground" Value="#142034" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6" /><Setter Property="MinHeight" Value="29" /><Setter Property="Foreground" Value="#142034" /><Setter Property="Background" Value="#DAE4F0" /></Style>
  </Application.Resources>
</Application>
