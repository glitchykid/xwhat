<Window x:Class="XWhat.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="X What · Настройки" Width="465" Height="710" MinWidth="430" MinHeight="530" Background="#0E141E" Foreground="#EFF5FC" WindowStartupLocation="CenterScreen">
 <Grid Margin="24" Background="#0E141E">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="X / WHAT" Foreground="#6FE7CF" FontSize="24" FontWeight="SemiBold" />
   <TextBlock Text="Меньше интерфейса. Больше понимания." Foreground="#A4B3C8" Margin="0,4,0,0" FontSize="12" />
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,9,12">
    <TextBlock Text="ВЫВОД" Foreground="#6FE7CF" FontSize="10" Margin="0,0,0,6" />
    <ComboBox x:Name="ModeBox"><ComboBoxItem Content="RTSS · эксклюзивный полный экран" /><ComboBoxItem Content="Окно Windows · без рамки / рабочий стол" /></ComboBox>
    <TextBlock Text="Для полного экрана установите и запустите RTSS. Положение, масштаб и обводка этого вывода задаются в RTSS." TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="11" Margin="0,6,0,3" />
    <TextBlock Margin="0,2,0,12"><Hyperlink Click="RtssLink_Click" Foreground="#6FE7CF">Страница загрузки RTSS</Hyperlink></TextBlock>
    <CheckBox x:Name="VisibleBox" Content="Показывать оверлей · Ctrl + Shift + F10" />
    <CheckBox x:Name="GraphsBox" Content="Графики кадров и нагрузки" />
    <CheckBox x:Name="ClickThroughBox" Content="Пропускать клики в игру (окно Windows)" />
    <TextBlock Text="ИГРА И ДАТЧИКИ" Foreground="#6FE7CF" FontSize="10" Margin="0,16,0,7" />
    <TextBlock Text="Процесс игры (.exe); пусто = активное окно" FontSize="12" Margin="0,0,0,5" />
    <DockPanel><Button Content="Список" DockPanel.Dock="Right" Margin="7,0,0,0" Click="Processes_Click" /><ComboBox x:Name="ProcessBox" IsEditable="True" /></DockPanel>
    <TextBlock Text="Видеокарта" FontSize="12" Margin="0,8,0,5" />
    <ComboBox x:Name="GpuBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
    <TextBlock Text="Диск" FontSize="12" Margin="0,8,0,5" />
    <ComboBox x:Name="DiskBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
    <TextBlock Text="I/O latency — средняя задержка всех дисков; для отдельного диска выводится «—». Температура RAM/VRAM зависит от доступных датчиков." TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="11" Margin="0,5,0,0" />
    <TextBlock Text="ГРАФИКИ" Foreground="#6FE7CF" FontSize="10" Margin="0,16,0,7" />
    <UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Опрос датчиков" FontSize="12" Margin="0,0,0,5" /><ComboBox x:Name="IntervalBox" /></StackPanel><StackPanel><TextBlock Text="История" FontSize="12" Margin="0,0,0,5" /><ComboBox x:Name="HistoryBox" /></StackPanel></UniformGrid>
    <DockPanel Margin="0,10,0,0"><TextBlock Text="Порог пика, ms" VerticalAlignment="Center" /><TextBox x:Name="ThresholdBox" Width="75" HorizontalAlignment="Right" /></DockPanel>
    <TextBlock Text="Пик: кадр выше порога и вдвое длиннее медианы. Причину ищите по совпадению с графиками нагрузки." TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="11" Margin="0,5,0,0" />
    <TextBlock Text="ОКНО WINDOWS" Foreground="#6FE7CF" FontSize="10" Margin="0,16,0,7" />
    <ComboBox x:Name="CornerBox"><ComboBoxItem Content="Слева сверху" /><ComboBoxItem Content="Справа сверху" /><ComboBoxItem Content="Слева снизу" /><ComboBoxItem Content="Справа снизу" /></ComboBox>
    <TextBlock Text="Масштаб · 75–200%" FontSize="12" Margin="0,9,0,0" /><Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5" />
    <TextBlock Text="Непрозрачность фона · данные всегда контрастные" FontSize="12" Margin="0,5,0,0" /><Slider x:Name="OpacitySlider" Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5" />
    <TextBlock Text="ДОСТУПНОСТЬ" Foreground="#6FE7CF" FontSize="10" Margin="0,16,0,7" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="11" />
    <TextBlock Text="Для CPU-температур LibreHardwareMonitor может требовать драйвер PawnIO и права администратора. Недоступные значения обозначены «—»." TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="11" Margin="0,7,0,0" />
    <TextBlock Margin="0,6,0,0"><Hyperlink Click="PawnIoLink_Click" Foreground="#6FE7CF">Официальный PawnIO</Hyperlink></TextBlock>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="ErrorText" Foreground="#FF728B" TextWrapping="Wrap" Margin="0,0,0,7" /><DockPanel><Button Content="Применить" Click="Apply_Click" Background="#6FE7CF" Foreground="#101821" /><Button Content="Закрыть" Click="Close_Click" /><TextBlock Text="v0.1.0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#72839B" /></DockPanel></StackPanel>
 </Grid>
</Window>
